#!/bin/bash

set -e

function SECTION() {
  {
    echo ""
    echo "-------------------------------------"
    echo "-- $1"
    echo "-------------------------------------"
  } | tee >(cat >&2)
}

# =====================================
SECTION "environment variables"
mount_path={{ env.mount }}
echo RUNNING IN $mount_path
config_path={{ env.config }}
echo config is in $config_path

# =====================================
SECTION "environment variables"
printenv

# =====================================
SECTION "set vars we need frequently"
RECIPE_BUILD={{ env.build }}
RECIPE=${RECIPE_BUILD}/store/meta/recipe
UENV_STORE={{ env.mount }}
SPACK_CMD="spack -C {{ env.config }} --debug"
SPACK_CMD="spack -C {{ env.config }}"

# =====================================
SECTION "source spack environment setup"
SPACK_ROOT=$( $SPACK_CMD location -r )
echo "SPACK_ROOT = $SPACK_ROOT"
source $SPACK_ROOT/share/spack/setup-env.sh

# =====================================
SECTION "create build environment from installed dependencies"

# SPACK_ENV_NAME must match the name of the stackinator environment.
SPACK_ENV_NAME="paraview-cuda"
STACKINATOR_ENV=${RECIPE_BUILD}/env/

# Use the helper script that builds CMAKE_PREFIX_PATH, PATH, PKG_CONFIG_PATH,
# CUDA_HOME, CC/CXX/FC, and PYTHONPATH from the exact installed prefixes.
# This avoids re-concretization and the pitfalls of 'spack env activate'.
source $RECIPE_BUILD/store/meta/recipe/scripts/setup-spack-build-env.sh -C {{ env.config }} -e ${STACKINATOR_ENV}

# =====================================
SECTION "download paraview sources..."
SRC_ROOT=$UENV_STORE/temp/src
BUILD_ROOT=$UENV_STORE/temp/build

# setup paths for src/build/install
PARAVIEW_VERSION_MAIN=6.1
PARAVIEW_VERSION_FULL=6.1.1
PARAVIEW_TAG="v${PARAVIEW_VERSION_FULL}"

PARAVIEW_GIT_URL=https://github.com/biddisco/ParaView.git
PARAVIEW_TAG=cscs-pv-zoltan-port

PARAVIEW_SRC_DIR=$SRC_ROOT/paraview-src
PARAVIEW_BUILD_DIR=$BUILD_ROOT/paraview
PARAVIEW_INSTALL_DIR=$UENV_STORE/paraview
PARAVIEW_PLUGINS_DIR=$UENV_STORE/paraview-plugins

mkdir -p $SRC_ROOT
mkdir -p $BUILD_ROOT
mkdir -p $PARAVIEW_INSTALL_DIR
mkdir -p $PARAVIEW_PLUGINS_DIR

if [ -d "${PARAVIEW_SRC_DIR}/.git" ]; then
    echo "ParaView source already exists, skipping clone and submodule update..."
else
    git clone --branch ${PARAVIEW_TAG} --depth 1 ${PARAVIEW_GIT_URL} ${PARAVIEW_SRC_DIR}
    pushd ${PARAVIEW_SRC_DIR}
    # Fetch the annotated tag object so that git describe / version detection works
    # in the shallow clone.
#    git fetch --depth 1 origin tag ${PARAVIEW_TAG}
    git submodule update --init --recursive
    popd
fi

# NOTE: a proper fix has been merged in master but it is not part of v6.1.0
# VTK's internal HDF5 module target conflicts with external HDF5. Rename it to
# VTK::hdf5vtk. Use a word boundary so already-renamed names are not re-renamed.
echo "Patching VTK::hdf5 CMake target problem..."
pushd $PARAVIEW_SRC_DIR
# In case a previous run double-renamed VTK::hdf5vtk to VTK::hdf5vtkvtk,
# normalize it back to VTK::hdf5vtk first.
git grep -lr --recurse-submodules "VTK::hdf5vtkvtk" 2>/dev/null | xargs -r sed -i 's/VTK::hdf5vtkvtk/VTK::hdf5vtk/g'
# Now rename any remaining VTK::hdf5 to VTK::hdf5vtk.
git grep -lr --recurse-submodules "VTK::hdf5\b" 2>/dev/null | xargs -r sed -i 's/VTK::hdf5\b/VTK::hdf5vtk/g'
popd

# NOTE: https://gitlab.kitware.com/vtk/vtk/-/work_items/19940
echo "Patching VTK with external Viskores CMake targets problem..."
# --forward makes patch a no-op if the change is already applied.
patch -N -p 1 -d $PARAVIEW_SRC_DIR/VTK <<-'EOF' || true
  diff --git a/ThirdParty/viskores/CMakeLists.txt b/ThirdParty/viskores/CMakeLists.txt
  index 468932c21a..917aef03bf 100644
  --- a/ThirdParty/viskores/CMakeLists.txt
  +++ b/ThirdParty/viskores/CMakeLists.txt
  @@ -30,4 +30,11 @@ vtk_module_third_party(

   if(VTK_MODULE_USE_EXTERNAL_vtkviskores)
     viskores_setup_job_pool()
  +
  +  get_property(
  +    _targets_list
  +    DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
  +    PROPERTY IMPORTED_TARGETS)
  +
  +  set_target_properties(${_targets_list} PROPERTIES IMPORTED_GLOBAL TRUE)
    endif()
EOF

# =====================================
SECTION "configure paraview build..."


cmake                                                       \
    -DCMAKE_BUILD_TYPE=Release                              \
    -DPARAVIEW_BUILD_EDITION=CANONICAL                      \
    -DPARAVIEW_BUILD_TESTING=OFF                            \
    -DPARAVIEW_BUILD_WITH_EXTERNAL=ON                       \
    -DPARAVIEW_INSTALL_DEVELOPMENT_FILES=ON                 \
    -DPARAVIEW_RELOCATABLE_INSTALL=OFF                      \
    -DPARAVIEW_VERSIONED_INSTALL=OFF                        \
    -DPARAVIEW_USE_CUDA=ON                                  \
    -DCMAKE_CUDA_ARCHITECTURES=90a                          \
    -DPARAVIEW_USE_MPI=ON                                   \
    -DPARAVIEW_USE_PYTHON=ON                                \
    -DPARAVIEW_USE_QT=OFF                                   \
    -DPARAVIEW_USE_VISKORES=ON                              \
    -DPARAVIEW_ENABLE_RAYTRACING:BOOL=ON                    \
    -DPARAVIEW_ENABLE_CATALYST=ON                           \
    -DPARAVIEW_ENABLE_WEB:BOOL=OFF                          \
    -DPARAVIEW_ENABLE_ADIOS2=ON                             \
    -DPARAVIEW_ENABLE_FIDES:BOOL=OFF                        \
    -DPARAVIEW_ENABLE_VISITBRIDGE:BOOL=OFF                  \
    -DPARAVIEW_PLUGIN_ENABLE_CDIReader=ON                   \
    -DPARAVIEW_PLUGIN_ENABLE_NetCDFTimeAnnotationPlugin=ON  \
    -DPARAVIEW_PLUGIN_ENABLE_pvNVIDIAIndeX=ON               \
    -DPARAVIEW_PLUGIN_AUTOLOAD_pvNVIDIAIndeX=OFF            \
    -DPARAVIEW_PLUGIN_ENABLE_pvGadgetReader=ON              \
    -DVTK_USE_X=OFF                                         \
    -DVTK_USE_Wayland=OFF                                   \
    -DVTK_OPENGL_HAS_EGL=ON                                 \
    -DVTK_SMP_IMPLEMENTATION_TYPE=TBB                       \
    -DVTK_MODULE_USE_EXTERNAL_VTK_hdf5=ON                   \
    -DVTK_MODULE_USE_EXTERNAL_VTK_scn=OFF                   \
    -DVTK_MODULE_USE_EXTERNAL_VTK_fast_float=OFF            \
    -DVTK_MODULE_USE_EXTERNAL_VTK_token=OFF                 \
    -DVTK_MODULE_USE_EXTERNAL_VTK_exprtk=OFF                \
    -DVTK_MODULE_USE_EXTERNAL_VTK_pegtl=OFF                 \
    -DVTK_MODULE_USE_EXTERNAL_VTK_vtkviskores=OFF           \
    -DVTKOSPRAY_ENABLE_DENOISER:BOOL=ON                     \
    -S $PARAVIEW_SRC_DIR                                    \
    -B $PARAVIEW_BUILD_DIR                                  \
    --install-prefix $PARAVIEW_INSTALL_DIR                  \
    -G Ninja

# =====================================
SECTION "build and install paraview"
cmake --build $PARAVIEW_BUILD_DIR -j
cmake --install $PARAVIEW_BUILD_DIR

# =====================================
SECTION "Install ParaView Plugin: CSCS plugins"
CSCS_PLUGINS_REPO=$SRC_ROOT/cscs-plugins.git
CSCS_PLUGINS_SOURCE=/capstor/store/cscs/cscs/csstaff/biddisco/gitrepos/plugins

if [ -d "${CSCS_PLUGINS_REPO}/.git" ]; then
    echo "CSCS plugins source already exists, pulling latest..."
    pushd ${CSCS_PLUGINS_REPO}
    git pull origin main
    popd
else
    git clone ${CSCS_PLUGINS_SOURCE} ${CSCS_PLUGINS_REPO}
fi

# Always initialize/update submodules. If a previous run failed partway,
# the directories may be empty and need repopulating.
pushd ${CSCS_PLUGINS_REPO}
# GIT_ALLOW_PROTOCOL is needed because pv-splotch points at a local
# filesystem path, while the other submodules use https.
GIT_ALLOW_PROTOCOL=file:https git submodule update --init ParaViewGadgetPlugin pv-zoltan pv-meshless pv-splotch
popd

# The ParaView/VTK source tree renames VTK::hdf5 to VTK::hdf5vtk. Patch any
# plugin vtk.module files that still reference the original module name.
SECTION "Patch CSCS plugins for VTK::hdf5 rename"
find "${CSCS_PLUGINS_REPO}" -name vtk.module -print0 | \
    xargs -0 -r sed -i 's/VTK::hdf5\b/VTK::hdf5vtk/g'

# pv-splotch uses cudaDeviceProp members (clockRate, deviceOverlap) that were
# removed in newer CUDA toolkits. Remove the obsolete diagnostic output.
SECTION "Patch pv-splotch for newer CUDA"
sed -i '/Clock rate:/,/Device will not handle overlaps/d' \
    "${CSCS_PLUGINS_REPO}/pv-splotch/cuda/cuda_device_query.cu"

cmake                                         \
  -G Ninja                                    \
  -S $CSCS_PLUGINS_REPO                       \
  -B $BUILD_ROOT/CSCSPlugins                  \
  -DCMAKE_PREFIX_PATH=$PARAVIEW_INSTALL_DIR   \
  -DCSCS_BUILD_pv_zoltan=ON                   \
  -DCSCS_BUILD_pv_meshless=ON                 \
  -DCSCS_BUILD_pv_splotch=ON                  \
  -DCSCS_BUILD_pv_gadget_reader=ON            \
  --install-prefix=$PARAVIEW_PLUGINS_DIR
cmake --build $BUILD_ROOT/CSCSPlugins -j
cmake --install $BUILD_ROOT/CSCSPlugins


# =====================================
SECTION "Install ParaView Plugin: NVIDIA IndeX"

mkdir -p $PARAVIEW_PLUGINS_DIR/nvidia-index

NVINDEX_FILENAME=nvidia-index-libs-6.0.0.20250604-linux-aarch64.tar.bz2
wget https://www.paraview.org/files/dependencies/$NVINDEX_FILENAME -O $BUILD_ROOT/nvidia-index.tar.bz2
tar --strip-components 1 --file $BUILD_ROOT/nvidia-index.tar.bz2 --directory $PARAVIEW_PLUGINS_DIR/nvidia-index --extract

# clean up extended attributes not supported on linux (not needed, just cleanup)
find $PARAVIEW_PLUGINS_DIR/nvidia-index -name "._*" -delete

# =====================================
SECTION "install helper scripts"
HELPERS_SRC=${RECIPE_BUILD}/store/meta/recipe/helpers
if [ -e "$HELPERS_SRC" ]; then
    # -L follows symlinks so a symlinked helpers dir in the recipe is copied as a real directory.
    cp -rL "$HELPERS_SRC" ${UENV_STORE}/
else
    echo "WARNING: helper scripts not found at $HELPERS_SRC, skipping copy"
    ls -la ${RECIPE_BUILD}/store/meta/recipe/ >&2
fi



# =====================================
# this runs during post install, paths are relative to the sandbox mount
SECTION "generate paraview proto-launch script for remote connection"
cmake \
    -DINPUT_FILE_NAME="${RECIPE_BUILD}/store/meta/recipe/scripts/rc-submit-pvserver.sh.cmake" \
    -DOUTPUT_FILE_NAME="${PARAVIEW_INSTALL_DIR}/rc-submit-pvserver.sh"                \
    -DPARAVIEW_VERSION=${PARAVIEW_VERSION_MAIN}                       \
    -DPARAVIEW_INSTALL_DIR=${PARAVIEW_INSTALL_DIR}                    \
    -DPARAVIEW_PLUGINS_DIR=${PARAVIEW_PLUGINS_DIR}                    \
    -DPV_LIBRARY_PATH=${PARAVIEW_PLUGINS_DIR}/nvidia-index/lib \
    -DUENV_IMAGE="@UENV_IMAGE@"                                       \
    -P ${RECIPE_BUILD}/store/meta/recipe/scripts/cmake-copy-substitute-vars.cmake

# =====================================
# this runs during post install, paths are relative to the sandbox mount
SECTION "Copy and substitute vars in gpu wrapper launch script helper"
cmake \
    -DINPUT_FILE_NAME="${RECIPE_BUILD}/store/meta/recipe/scripts/gpu_wrapper.sh.cmake" \
    -DOUTPUT_FILE_NAME="${PARAVIEW_INSTALL_DIR}/gpu_wrapper.sh"                \
    -DPV_LIBRARY_PATH=${PARAVIEW_PLUGINS_DIR}/nvidia-index/lib \
    -P ${RECIPE_BUILD}/store/meta/recipe/scripts/cmake-copy-substitute-vars.cmake

# =====================================
# this runs during post install, but writes a new script that is run
# after the user has mounted the uenv, so here $HOME refers to the user's home
SECTION "generate final user-init script to finalize paraview launch script for remote connection"

cat <<EOF > $mount_path/init.sh
#!/bin/bash
echo "Copying Remote-Connection pvserver launch script to users' home directory"

PVSERVER_LAUNCH_SCRIPT="\${HOME}/rc-pvserver-\${CLUSTER_NAME}.sh"

if [ -f "\${PVSERVER_LAUNCH_SCRIPT}" ]; then
    echo "Backing up existing \${PVSERVER_LAUNCH_SCRIPT}"
    mv "\${PVSERVER_LAUNCH_SCRIPT}" "\${PVSERVER_LAUNCH_SCRIPT}.\$(date +%Y-%m-%d)"
fi

# each alps cluster has its own CLUSTER_NAME environment variable
# UENV_MOUNT_FILE is set by the uenv image/engine when loaded
cmake \
    -DINPUT_FILE_NAME="${PARAVIEW_INSTALL_DIR}/rc-submit-pvserver.sh"    \
    -DOUTPUT_FILE_NAME="\${PVSERVER_LAUNCH_SCRIPT}"                       \
    -DUENV_IMAGE="\${UENV_MOUNT_FILE}"                                    \
    -P ${RECIPE_BUILD}/store/meta/recipe/scripts/cmake-copy-substitute-vars.cmake

EOF
chmod +x $mount_path/init.sh

SECTION "cleanup"
rm -rf ${UENV_STORE}/temp

# =====================================
SECTION "Done"
